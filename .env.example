# Optional Docker Compose variables for ./docker-compose.with-adaptive-sql-diploma.yml.
# Copy to .env inside adaptive-learning-stack/ if you need non-default paths.

# The uploaded archive has adaptive-learning-stack/ and adaptive_sql_diploma/ as sibling directories.
ADAPTIVE_SQL_DIPLOMA_ROOT=../adaptive_sql_diploma
ADAPTIVE_SQL_DIPLOMA_MODELS_HOST=../adaptive_sql_diploma/models/base
ADAPTIVE_SQL_DIPLOMA_LORA_HOST=../adaptive_sql_diploma/lora_sql_mastery

# api-gateway already uses 8080, so intelligence is exposed on 8090 by default.
INTELLIGENCE_HOST_PORT=8090
INTELLIGENCE_GPU_HOST_PORT=8091

# LLM backend for the Python intelligence service.
# local  = use Hugging Face base model + lora_sql_mastery adapter.
# ollama = call an already running Ollama server, useful for smoke tests.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q6_K
OLLAMA_TIMEOUT_SECONDS=600
