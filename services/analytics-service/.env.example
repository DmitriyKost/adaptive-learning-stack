ENV=local
HTTP_ADDR=:8083

CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USERNAME=analytics
CLICKHOUSE_PASSWORD=analytics
CLICKHOUSE_SECURE=false
CLICKHOUSE_AUTO_MIGRATE=true

KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=analytics-service
KAFKA_GROUP_ID=analytics-service
KAFKA_TOPIC_TASK_CHECKED=task.checked
KAFKA_TOPIC_TASK_COMPLETED=task.completed
KAFKA_TOPIC_TASK_RECOMMENDED=task.recommended
KAFKA_TOPIC_LEARNER_MODEL_UPDATED=learner_model.updated
KAFKA_TOPIC_ANALYTICS_SKILL_ASSESSMENT_UPDATED=analytics.skill_assessment.updated
KAFKA_TOPIC_CAREER_RECOMMENDATION_CREATED=analytics.career_recommendation.created
KAFKA_TOPIC_ANALYTICS_HINT_GENERATED=analytics.hint.generated

INTELLIGENCE_BASE_URL=http://127.0.0.1:8080
INTELLIGENCE_API_KEY=
INTELLIGENCE_READY_PATH=/ready
INTELLIGENCE_EVALUATE_PATH=/v1/assessments/evaluate
INTELLIGENCE_HINT_PATH=/v1/hints/generate
INTELLIGENCE_HTTP_TIMEOUT=600s
INTELLIGENCE_INCLUDE_CAREER=false

HINT_GENERATION_TIMEOUT=600s
